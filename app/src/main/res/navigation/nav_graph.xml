<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.firstproject.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_homeFragment_to_addHabitFragment"
            app:destination="@id/addHabitFragment" />
    </fragment>
    <fragment
        android:id="@+id/addHabitFragment"
        android:name="com.example.firstproject.ui.habit.AddHabitFragment"
        android:label="@string/title_add_habit"
        tools:layout="@layout/fragment_add_habit">
        <!-- A new habit goes straight to scheduling; Back from there returns to Home, not the filled form -->
        <action
            android:id="@+id/action_addHabitFragment_to_createScheduleFragment"
            app:destination="@id/createScheduleFragment"
            app:popUpTo="@id/addHabitFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/createScheduleFragment"
        android:name="com.example.firstproject.ui.schedule.CreateScheduleFragment"
        android:label="@string/title_create_schedule"
        tools:layout="@layout/fragment_create_schedule">
        <!-- Habit to preselect; -1 lets the user pick one of their existing habits -->
        <argument
            android:name="habitId"
            android:defaultValue="-1L"
            app:argType="long" />
        <!-- No habits yet: swap to the AddHabit form -->
        <action
            android:id="@+id/action_createScheduleFragment_to_addHabitFragment"
            app:destination="@id/addHabitFragment"
            app:popUpTo="@id/createScheduleFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Session expired (refresh token rejected): back to login with an empty back stack -->
    <action
        android:id="@+id/action_global_loginFragment"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.firstproject.ui.auth.LoginFragment"
        android:label="@string/nav_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.firstproject.ui.auth.RegisterFragment"
        android:label="@string/nav_register"
        tools:layout="@layout/fragment_register" >
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <!-- Signup returns tokens, so the new user goes straight to Home; login + register leave the back stack -->
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.firstproject.ui.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
