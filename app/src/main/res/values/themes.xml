<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Frutiger Aero light-only theme. There is intentionally no values-night variant. -->
    <style name="Theme.Aero" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/aero_sky</item>
        <item name="colorPrimaryVariant">@color/aero_sky_deep</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/aero_lime</item>
        <item name="colorSecondaryVariant">@color/aero_grass</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/aero_aqua</item>
        <item name="colorControlActivated">@color/aero_aqua</item>
        <item name="colorControlHighlight">@color/aero_glass_fill</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/aero_text_dark</item>
        <item name="android:colorBackground">@color/aero_sky</item>
        <item name="android:textColorPrimary">@color/aero_text_dark</item>
        <item name="android:textColorSecondary">@color/aero_text_muted</item>

        <!-- Typography -->
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>

        <!-- Edge-to-edge, light mode only -->
        <item name="android:windowBackground">@drawable/bg_sky</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Default widget styles -->
        <item name="textInputStyle">@style/Widget.Aero.TextInput</item>
        <item name="bottomNavigationStyle">@style/Widget.Aero.BottomNav</item>
        <item name="toolbarStyle">@style/Widget.Aero.Toolbar</item>
        <item name="snackbarStyle">@style/Widget.Aero.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.Aero.Snackbar.TextView</item>
    </style>
</resources>
