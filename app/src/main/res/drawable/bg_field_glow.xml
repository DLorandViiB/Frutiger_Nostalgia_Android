<?xml version="1.0" encoding="utf-8"?>
<!-- Blue halo drawn around a text field while it has focus (see Widget.Aero.TextInput.Glow). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="26dp" />
                    <solid android:color="#2627C8E8" />
                </shape>
            </item>
            <item
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="25dp" />
                    <solid android:color="#3327C8E8" />
                    <stroke
                        android:width="1dp"
                        android:color="#6627C8E8" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
