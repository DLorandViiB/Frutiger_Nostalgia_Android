<?xml version="1.0" encoding="utf-8"?>
<!-- Home: blue glass orb with a house. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <group>
        <!-- Orb body: radial light from below, darker towards the rim -->
        <path
            android:pathData="M48,48m-44,0a44,44 0,1 1,88 0a44,44 0,1 1,-88 0"
            android:strokeWidth="1.5"
            android:strokeColor="#990A4E96">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="48"
                    android:centerY="70"
                    android:gradientRadius="60"
                    android:type="radial">
                    <item android:color="#FFC2F2FF" android:offset="0" />
                    <item android:color="#FF2E9BEA" android:offset="0.55" />
                    <item android:color="#FF0B5FB8" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Glyph drop shadow -->
        <group android:translateX="0" android:translateY="1.5">
        <path
            android:fillColor="#590A3557"
            android:pathData="M48,24 L74,47 L67,47 L67,69 L55,69 L55,56 L41,56 L41,69 L29,69 L29,47 L22,47 Z" />
        </group>
        <!-- Glyph -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M48,24 L74,47 L67,47 L67,69 L55,69 L55,56 L41,56 L41,69 L29,69 L29,47 L22,47 Z" />
        <!-- Specular cap highlight -->
        <path android:pathData="M48,7 C66,7 79,17 79,29 C79,40 65,46 48,46 C31,46 17,40 17,29 C17,17 30,7 48,7 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="48"
                    android:endY="46"
                    android:startX="48"
                    android:startY="7"
                    android:type="linear">
                    <item android:color="#F2FFFFFF" android:offset="0" />
                    <item android:color="#14FFFFFF" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Bottom rim light -->
        <path
            android:pathData="M24,76 C34,86 62,86 72,76"
            android:strokeLineCap="round"
            android:strokeWidth="2"
            android:strokeColor="#66FFFFFF" />
    </group>
</vector>
