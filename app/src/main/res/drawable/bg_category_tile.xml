<?xml version="1.0" encoding="utf-8"?>
<!-- Category tile in the AddHabit grid: the selected tile gets a glossy glass pill with an aqua rim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#E6FFFFFF"
                android:endColor="#668FDBFF" />
            <stroke
                android:width="@dimen/aero_stroke_focus"
                android:color="@color/aero_aqua" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/aero_glass_fill" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
