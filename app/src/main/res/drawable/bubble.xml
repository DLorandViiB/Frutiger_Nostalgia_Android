<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent soap/water bubble: clear centre, aqua rim, specular highlight top-left. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Body: transparent in the middle, tinted towards the edge -->
    <path
        android:pathData="M50,50m-47,0a47,47 0,1 1,94 0a47,47 0,1 1,-94 0"
        android:strokeWidth="1.5"
        android:strokeColor="#CCFFFFFF">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="50"
                android:centerY="54"
                android:gradientRadius="47"
                android:type="radial">
                <item android:color="#0DFFFFFF" android:offset="0" />
                <item android:color="#1A8FDBFF" android:offset="0.7" />
                <item android:color="#7327C8E8" android:offset="0.95" />
                <item android:color="#99FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Curved specular highlight -->
    <path android:pathData="M20,40 C22,26 34,15 48,13 C40,18 30,28 27,42 C25,46 19,46 20,40 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="40"
                android:endY="40"
                android:startX="24"
                android:startY="18"
                android:type="linear">
                <item android:color="#F2FFFFFF" android:offset="0" />
                <item android:color="#33FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#E6FFFFFF"
        android:pathData="M58,19m-4,0a4,3 0,1 1,8 0a4,3 0,1 1,-8 0" />

    <!-- Small reflection bottom-right -->
    <path
        android:pathData="M70,80 C76,76 80,70 82,63"
        android:strokeLineCap="round"
        android:strokeWidth="3"
        android:strokeColor="#80FFFFFF" />
</vector>
