                    <item android:color="#FF5CC234" android:offset="0.55" />
                    <item android:color="#FF1E7A1E" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Glyph drop shadow -->
        <group android:translateX="0" android:translateY="1.5">
        <path
            android:fillColor="#590A3557"
            android:pathData="M44,18 C46,34 50,40 66,44 C50,48 46,54 44,70 C42,54 38,48 22,44 C38,40 42,34 44,18 Z" />
