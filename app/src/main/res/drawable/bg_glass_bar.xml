<?xml version="1.0" encoding="utf-8"?>
<!-- Glossy glass bottom bar: rounded top corners, white rim, bright reflection on the upper half. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Rim / shadow line -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/aero_radius_bar"
                android:topRightRadius="@dimen/aero_radius_bar" />
            <solid android:color="#4D0A3A6B" />
        </shape>
    </item>
    <!-- Glass body -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/aero_radius_bar"
                android:topRightRadius="@dimen/aero_radius_bar" />
            <gradient
                android:angle="270"
                android:startColor="#F2FFFFFF"
                android:centerColor="#CCE9F8FF"
                android:endColor="#E6D2F1FF" />
            <stroke
                android:width="@dimen/aero_stroke_glass"
                android:color="@color/white" />
        </shape>
    </item>
    <!-- Upper reflection -->
    <item
        android:gravity="top|fill_horizontal"
        android:height="28dp"
        android:left="6dp"
        android:right="6dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="21dp"
                android:topRightRadius="21dp" />
            <gradient
                android:angle="270"
                android:startColor="#E6FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
