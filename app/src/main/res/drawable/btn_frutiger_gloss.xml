<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base border / slight drop shadow effect -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#7799CC" />
        </shape>
    </item>

    <!-- Inner deep aquatic gradient -->
    <item android:bottom="2dp" android:right="2dp" android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="90"
                android:startColor="#2A75D3"
                android:endColor="#5BB0FF"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#003366" />
        </shape>
    </item>

    <!-- The signature harsh top-glass highlight -->
    <item android:bottom="22dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp" />
            <gradient
                android:angle="270"
                android:startColor="#AAFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>