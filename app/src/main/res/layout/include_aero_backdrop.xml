<?xml version="1.0" encoding="utf-8"?>
<!-- Shared Frutiger Aero scenery: light rays, rolling hills and floating bubbles.
     Include it as the first child of a FrameLayout whose background is @drawable/bg_sky. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_light_rays" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/aero_hills_height"
        android:layout_gravity="bottom"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_hills" />

    <com.example.firstproject.ui.common.BubbleFieldView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</merge>
