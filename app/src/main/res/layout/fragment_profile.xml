<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:background="@drawable/bg_sky"
    tools:context=".ui.profile.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/aero_gutter">

        <LinearLayout
            style="@style/Widget.Aero.Card.Glass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivAvatar"
                style="@style/Widget.Aero.Orb"
                android:layout_width="@dimen/aero_orb_avatar"
                android:layout_height="@dimen/aero_orb_avatar"
                android:contentDescription="@string/cd_avatar"
                android:src="@drawable/ic_orb_profile" />

            <ImageView
                style="@style/Widget.Aero.OrbGlow"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aero_spacing_small"
                android:text="@string/profile_username_placeholder"
                android:textAppearance="@style/TextAppearance.Aero.Title" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_email_placeholder"
                android:textAppearance="@style/TextAppearance.Aero.Caption" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Aero.Button.Glossy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/aero_card_spacing"
                android:text="@string/action_logout" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
