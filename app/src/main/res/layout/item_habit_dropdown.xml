<?xml version="1.0" encoding="utf-8"?>
<!-- Row in the CreateSchedule habit picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/aero_spacing"
    android:paddingTop="6dp"
    android:paddingEnd="@dimen/aero_spacing"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/ivOrb"
        style="@style/Widget.Aero.Orb"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_orb_category_running" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Aero.Body"
            android:textStyle="bold"
            tools:text="Morning Run" />

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Aero.Caption"
            tools:text="Running" />
    </LinearLayout>
</LinearLayout>
