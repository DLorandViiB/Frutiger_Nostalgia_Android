<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sky"
    tools:context=".SplashActivity">

    <include layout="@layout/include_aero_backdrop" />

    <LinearLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/aero_gutter">

        <ImageView
            android:layout_width="@dimen/aero_orb_avatar"
            android:layout_height="@dimen/aero_orb_avatar"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/ic_orb_logo"
            style="@style/Widget.Aero.Orb" />

        <ImageView
            style="@style/Widget.Aero.OrbGlow"
            android:importantForAccessibility="no"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aero_spacing_small"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.Aero.Display" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/tagline"
            android:textAppearance="@style/TextAppearance.Aero.Subtitle" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button"
            style="@style/Widget.Aero.Button.Glossy.Green"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/aero_spacing_large"
            android:text="@string/splash_get_started" />
    </LinearLayout>
</FrameLayout>
